# ============================================================
#  Sistema Delivery — Variables de entorno de ejemplo
#  Copia este archivo a .env y ajusta los valores.
#  NO incluyas secretos reales en el repositorio.
# ============================================================

# ------------------------------------------------------------
# API Gateway (host)
# ------------------------------------------------------------
# Puerto del host para exponer el API Gateway. En algunos equipos el
# 5000 está reservado por el sistema; en ese caso usa otro (ej. 5050).
GATEWAY_PORT=5000

# ------------------------------------------------------------
# Seguridad
# ------------------------------------------------------------
# Secreto para firmar/verificar los tokens JWT.
# Lo usan el API Gateway y el usuario-service. ¡Cámbialo en producción!
JWT_SECRET=cambia_este_secreto_en_produccion

# Entorno de ejecución (desarrollo | produccion)
NODE_ENV=desarrollo

# ------------------------------------------------------------
# URLs internas de los microservicios (las usa el API Gateway
# y la orquestación de pedidos). En Docker se resuelven por el
# nombre del servicio dentro de la red interna.
# ------------------------------------------------------------
INVENTARIO_SERVICE_URL=http://inventario-service:3001
SUCURSALES_SERVICE_URL=http://sucursales-service:3002
PEDIDOS_SERVICE_URL=http://pedidos-service:3003
REPARTIDORES_SERVICE_URL=http://repartidores-service:3004
USUARIO_SERVICE_URL=http://usuario-service:3005
ENRUTAMIENTO_SERVICE_URL=http://enrutamiento-service:3006
API_GATEWAY_URL=http://api-gateway:5000

# ------------------------------------------------------------
# Conexiones a MongoDB (una base de datos por microservicio)
# NOTA: inventario-service usa MONGODB_URI; el resto usa MONGO_URI.
# ------------------------------------------------------------
MONGODB_URI=mongodb://mongodb:27017/productosdb        # inventario-service
MONGO_URI_SUCURSALES=mongodb://mongodb:27017/delivery_sucursales
MONGO_URI_PEDIDOS=mongodb://mongodb:27017/pedidosdb
MONGO_URI_REPARTIDORES=mongodb://mongodb:27017/repartidoresdb
MONGO_URI_USUARIOS=mongodb://mongodb:27017/usuariosdb
MONGO_URI_ENRUTAMIENTO=mongodb://mongodb:27017/enrutamientodb

# ------------------------------------------------------------
# inventario-service: URL pública para construir las rutas de
# imágenes subidas (uploads).
# ------------------------------------------------------------
INVENTARIO_PUBLIC_URL=http://localhost:8109/api

# ------------------------------------------------------------
# Frontend (modo desarrollo con Vite) — definir en frontend/.env
# ------------------------------------------------------------
# VITE_API_URL=http://localhost:5000/api
